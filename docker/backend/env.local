# Local .env template for gym-backend, copied to gym-backend/.env on first boot.
#
# Why a file and not compose `environment:`? `php artisan serve` only forwards a
# whitelist of env vars to the PHP dev server (Laravel's ServeCommand), so container
# env vars never reach the served app — the .env file is the source of truth here.
#
# Edit gym-backend/.env directly for local tweaks; delete it and restart to reset.
APP_NAME=HOM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8881
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=hom
DB_USERNAME=hom
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# MinIO — local S3-compatible storage, console at http://localhost:9001 (hom/hom-secret)
AWS_ACCESS_KEY_ID=hom
AWS_SECRET_ACCESS_KEY=hom-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hom-local
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/hom-local
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mailpit — read everything at http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="local@hom.test"
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=true

# Third-party integrations — fill in only if you work on those features.
FIREBASE_CREDENTIALS=storage/app/private/firebase-credentials.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PARTNER_AMPABA_ACCESS=
AMPABA_TOKEN=
AMPABA_BASE_URL=
AMPABA_CLIENT_ID=
